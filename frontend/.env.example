# Public browser configuration. Copy to frontend/.env and restart Vite.
# Cognito user pool issuer (not the managed login domain):
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_REPLACE_ME
VITE_COGNITO_CLIENT_ID=replace-with-public-app-client-id
# Full managed login domain, including https://:
VITE_COGNITO_DOMAIN=https://replace-me.auth.us-east-1.amazoncognito.com
